// -*- mode: jsonc -*-
// NC Night · floating islands
{
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "margin-top": 2,
    "margin-left": 4,
    "margin-right": 4,
    "reload_style_on_change": true,

    "modules-left": [
        "group/ws",
        "custom/media"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "group/utils",
        "group/sysinfo",
        "group/conn",
        "group/energy",
        "clock",
        "custom/power"
    ],

    // ── Groups (each renders as one island) ──────────────────────────
    "group/ws": {
        "orientation": "horizontal",
        "modules": [
            "sway/workspaces",
            "sway/mode",
            "sway/scratchpad"
        ]
    },
    "group/utils": {
        "orientation": "horizontal",
        "modules": [
            "privacy",
            "idle_inhibitor",
            "custom/notification",
            "tray"
        ]
    },
    // Drawers: the FIRST module is the always-visible handle, the rest reveal
    // on hover. Handles are chosen to stay useful while collapsed — cpu shows
    // load, network shows offline state, battery shows charge.
    "group/sysinfo": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "drawer-child"
        },
        "modules": [
            "cpu",
            "memory",
            "temperature"
        ]
    },
    "group/conn": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "drawer-child"
        },
        "modules": [
            "network",
            "pulseaudio",
            "bluetooth"
        ]
    },
    "group/energy": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "drawer-child"
        },
        "modules": [
            // "power-profiles-daemon" dropped: TLP replaced tuned-ppd and does
            // not implement the PPD D-Bus interface, so the module can only error.
            "battery",
            "backlight"
        ]
    },

    // ── Left ─────────────────────────────────────────────────────────
    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "warp-on-scroll": false,
        // Plain digits: the Nerd Font circled numerals (󰲠 󰲢 …) render thin and
        // low-contrast at bar sizes. Styling carries the state instead.
        "format": "{name}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": []
        }
    },

    "sway/mode": {
        "format": "󰌌 <span style=\"italic\">{}</span>",
        "tooltip": false
    },

    "sway/scratchpad": {
        "format": "󰘸 {count}",
        "show-empty": false,
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "custom/media": {
        "format": "{icon} {}",
        "return-type": "json",
        "max-length": 45,
        "escape": true,
        "format-icons": {
            "playing": "󰎇",
            "paused": "󰏤"
        },
        "exec": "$HOME/.config/waybar/scripts/media.sh",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-"
    },

    // ── Center ───────────────────────────────────────────────────────
    "sway/window": {
        "format": "{title}",
        "max-length": 48,
        "separate-outputs": true,
        "icon": true,
        "icon-size": 13,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Brave": "$1",
            "(.*) - Visual Studio Code": "$1",
            "(.*) - Thunar": "󰉋  $1"
        },
        "tooltip": false
    },

    // ── Right · utils ────────────────────────────────────────────────
    "privacy": {
        "icon-spacing": 6,
        "icon-size": 13,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare", "tooltip": true },
            { "type": "audio-in", "tooltip": true }
        ]
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "tooltip-format-activated": "Idle inhibited — screen stays on",
        "tooltip-format-deactivated": "Idle normal — screen may lock",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰛊"
        }
    },

    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "tray": {
        "icon-size": 13,
        "spacing": 6
    },

    // ── Right · sysinfo ──────────────────────────────────────────────
    // Poll intervals below are deliberately slow: these modules sit collapsed
    // inside drawers and poll regardless of visibility, so each tick is a CPU
    // wakeup buying a number nobody is looking at.
    "cpu": {
        "interval": 5,
        "format": "󰻠 {usage}%",
        "tooltip-format": "CPU {usage}%  ·  load {load}\n\nClick: btop",
        "on-click": "kitty -e btop"
    },

    "memory": {
        "interval": 10,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "RAM  {used:0.1f}G / {total:0.1f}G\nSwap {swapUsed:0.1f}G / {swapTotal:0.1f}G\n\nClick: btop",
        "on-click": "kitty -e btop"
    },

    "temperature": {
        // Package id 0 — stable path, survives hwmon renumbering
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 82,
        "interval": 10,
        "format": "{icon} {temperatureC}°",
        "format-icons": ["󰈸", "󰈸", "󰈸"],
        "tooltip-format": "CPU package: {temperatureC}°C"
    },

    // ── Right · conn ─────────────────────────────────────────────────
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂰 {volume}%",
        "format-bluetooth-muted": "󰝟 ",
        "format-muted": "󰝟 muted",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc} · {volume}%\n\nClick: devices · Middle: pavucontrol · Right: mute · Scroll: volume",
        "on-click": "$HOME/.config/waybar/scripts/audio-menu.sh",
        "on-click-middle": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "network": {
        "interval": 10,
        // Icon only — the SSID is long ("Bbox-62891E69") and lives in the tooltip.
        "format-wifi": "{icon}",
        "format-ethernet": "󰈁",
        "format-linked": "󰈂",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid}  ({signalStrength}%)\n{ifname} · {ipaddr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}\n\nClick: networks · Middle: toggle Wi-Fi · Right: settings",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}\n\nClick: networks · Right: settings",
        "tooltip-format-disconnected": "No network\n\nClick: pick a network",
        "max-length": 22,
        "on-click": "$HOME/.config/waybar/scripts/wifi-menu.sh",
        "on-click-middle": "sh -c 'if nmcli radio wifi | grep -q enabled; then nmcli radio wifi off; else nmcli radio wifi on; fi'",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}\n\nClick: devices · Middle: toggle · Right: Blueman",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}\n\nClick: devices · Middle: toggle · Right: Blueman",
        "tooltip-format-enumerate-connected": "󰂱 {device_alias}",
        "tooltip-format-enumerate-connected-battery": "󰂱 {device_alias}  󰁹 {device_battery_percentage}%",
        "on-click": "$HOME/.config/waybar/scripts/bluetooth-menu.sh",
        "on-click-middle": "sh -c 'if bluetoothctl show | grep -q \"Powered: yes\"; then bluetoothctl power off; else bluetoothctl power on; fi'",
        "on-click-right": "blueman-manager"
    },

    // ── Right · energy ───────────────────────────────────────────────
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Backlight {percent}%\n\nScroll: brightness",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },


    "battery": {
        "interval": 60,
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-full": "󰁹 full",
        // Click swaps the label to time remaining; click again to go back.
        "format-alt": "{icon} {time}",
        "format-time": "{H}h {M}m",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{capacity}%  ·  {timeTo}\n\nDraw    {power:0.1f} W\nHealth  {health}\nCycles  {cycles}\n\nClick: toggle time left"
    },

    // ── Right · standalone ───────────────────────────────────────────
    "clock": {
        "interval": 30,
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%a %d %b}",
        "tooltip-format": "<span size='11500'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":  "<span color='#d8d4c9'><b>{}</b></span>",
                "days":    "<span color='#a3a8b0'>{}</span>",
                "weeks":   "<span color='#6d8cc8'><b>W{}</b></span>",
                "weekdays":"<span color='#c9a66a'><b>{}</b></span>",
                "today":   "<span color='#7f9acb'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "swaylock -f",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate",
            "logout": "swaymsg exit",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
