{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": { "top": 2, "right": 4 }
    },
    "display": {
        "separator": "   ",
        "color": "bright_white",
        "key": { "width": 14, "color": "bright_white" },
        "bar": {
            "width": 15,
            "char": { "elapsed": "━", "total": "─" },
            "color": { "elapsed": "bright_white", "total": "bright_black" }
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#bright_blue} {#bright_white}{user-name}{#bright_black}@{#bright_cyan}{host-name}"
        },
        {
            "type": "custom",
            "format": " Fedora Workstation 44",
            "outputColor": "bright_green"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────────",
            "outputColor": "bright_black"
        },
        {
            "type": "os",
            "key": "  󰣇 OS",
            "keyColor": "bright_cyan"
        },
        {
            "type": "kernel",
            "key": "   KERNEL",
            "keyColor": "bright_cyan",
            "format": "{1} {2}"
        },
        {
            "type": "shell",
            "key": "   SHELL",
            "keyColor": "bright_cyan"
        },
        {
            "type": "packages",
            "key": "  󰏗 PACKAGES",
            "keyColor": "bright_cyan",
            "format": "{1} (rpm), {2} (flatpak)"
        },
        {
            "type": "uptime",
            "key": "  󰅐 UPTIME",
            "keyColor": "bright_cyan"
        },
        "break",
        {
            "type": "custom",
            "format": "──────────────────────────────────────",
            "outputColor": "bright_black"
        },
        {
            "type": "wm",
            "key": "   WM",
            "keyColor": "bright_magenta"
        },
        {
            "type": "icons",
            "key": "  󰀻 ICONS",
            "keyColor": "bright_magenta"
        },
        {
            "type": "terminal",
            "key": "   TERM",
            "keyColor": "bright_magenta"
        },
        {
            "type": "cursor",
            "key": "  󰖝 CURSOR",
            "keyColor": "bright_magenta"
        },
        "break",
        {
            "type": "custom",
            "format": "──────────────────────────────────────",
            "outputColor": "bright_black"
        },
        {
            "type": "custom",
            "format": "󰢮  Hardware",
            "outputColor": "bright_yellow"
        },
        {
            "type": "cpu",
            "key": "  󰻠 CPU",
            "format": "{1} ({3})",
            "keyColor": "bright_yellow",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "  󰢮 GPU",
            "format": "{2}",
            "keyColor": "bright_yellow",
            "maxCount": 2
        },
        {
            "type": "memory",
            "key": "  󰍛 RAM",
            "keyColor": "bright_yellow",
            "percent": { "type": ["bar", "num"] }
        },
        {
            "type": "disk",
            "key": "  󰋊 DISK",
            "folders": "/",
            "keyColor": "bright_yellow",
            "percent": { "type": ["bar", "num"] }
        },
        {
            "type": "swap",
            "key": "  󰓡 SWAP",
            "keyColor": "bright_yellow",
            "percent": { "type": ["bar", "num"] }
        },
        "break",
        {
            "type": "custom",
            "format": "──────────────────────────────────────",
            "outputColor": "bright_black"
        },
        {
            "type": "display",
            "key": "  󰍹 DISPLAY",
            "compactType": "original-with-refresh-rate",
            "keyColor": "bright_white"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle",
            "block": {
                "width": 1
            }
        },
        "break"
    ]
}
