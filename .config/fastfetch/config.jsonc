{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Everforest Dark greeting · ANSI names map to the kitty palette
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/nc.ans",
        "width": 52,
        "height": 9,
        "padding": { "top": 4, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 12 },
        "color": { "keys": "37", "output": "white" },
        "bar": {
            "width": 12,
            "char": { "elapsed": "━", "total": "━" },
            "border": { "left": "", "right": "" },
            "color": { "elapsed": "37", "total": "90" }
        },
        "percent": { "color": { "green": "green", "yellow": "yellow", "red": "red" } }
    },
    "modules": [
        {
            "type": "command",
            "key": " ",
            "text": "h=$(date +%H); if [ $h -lt 6 ]; then g='late night'; elif [ $h -lt 12 ]; then g='good morning'; elif [ $h -lt 18 ]; then g='good afternoon'; else g='good evening'; fi; printf '%s, \\033[1;37m%s\\033[0m  \\033[90m·  人馬一体  ·  %s\\033[0m' \"$g\" \"$USER\" \"$(date '+%H:%M')\""
        },
        { "type": "custom", "format": "{#90}╭─{#31} system {#90}──────────────────────────" },
        { "type": "os",       "key": "{#90}│{#37} 󰣛  os",     "format": "{name} {version-id}" },
        { "type": "kernel",   "key": "{#90}│{#37}   kernel", "format": "{release}" },
        { "type": "wm",       "key": "{#90}│{#37}   wm" },
        { "type": "shell",    "key": "{#90}│{#37}   shell" },
        { "type": "uptime",   "key": "{#90}│{#37} 󰅐  uptime" },
        { "type": "packages", "key": "{#90}│{#37} 󰏗  pkgs" },
        { "type": "custom", "format": "{#90}├─{#yellow} hardware {#90}────────────────────────" },
        { "type": "cpu",    "key": "{#90}│{#yellow} 󰻠  cpu",  "format": "{name}", "showPeCoreCount": false },
        { "type": "gpu",    "key": "{#90}│{#yellow} 󰢮  gpu",  "format": "{name}", "hideType": "integrated" },
        { "type": "memory", "key": "{#90}│{#yellow} 󰍛  mem",  "percent": { "type": ["bar", "num"] } , "format": "{percentage-bar} {percentage}" },
        { "type": "disk",   "key": "{#90}│{#yellow} 󰋊  disk", "folders": "/", "percent": { "type": ["bar", "num"] }, "format": "{size-percentage-bar} {size-percentage}" },
        { "type": "custom", "format": "{#90}╰──────────────────────────────────" },
        { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
    ]
}
